{
  "id": "cailleach",
  "name": "Cailleach",
  "intent": "reductive",
  "description": "The Bone. Structure-first separation prioritising spatial entropy and boundary noise.",
  "centroidStrategy": "ROBUST_SALIENCY",
  "spatialWeight": { "value": 1.5, "default": 1.5, "min": 1.0, "max": 3.0, "modulateBy": "spatialEntropy", "sensitivity": 1.5 },
  "edgePreservation": { "value": 0.8, "default": 0.8, "min": 0.0, "max": 1.0 },
  "cWeight": { "value": 0.3, "default": 0.3, "min": 0.1, "max": 0.5 },
  "minVolume": { "value": 4.0, "default": 4.0, "min": 3.0, "max": 5.0 },
  "steps": [
    { "op": "substrate_detection" },
    { "op": "cull", "color": { "L": 100, "a": 0, "b": 0 }, "tolerance": 6.0, "preserve": true },
    { "op": "quantize", "algorithm": "median-cut" },
    { "op": "prune" },
    { "op": "map", "dither": "none" },
    { "op": "refine", "params": { "iterations": 2 } },
    { "op": "rescue", "params": { "chromaThreshold": 10, "distinctnessThreshold": 12 } },
    { "op": "inject", "color": "substrate" },
    { "op": "map", "dither": "auto" }
  ]
}
