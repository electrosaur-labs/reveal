{
    "id": "reveal-mk1.5-reference",
    "name": "Reveal Mk 1.5 (Reference)",
    "type": "classical",
    "description": "Exact reproduction of the legacy Reveal Mk 1.5 pipeline.",
    "steps": [
        { "op": "snap_lab", "shadowThreshold": {"value": 6.0, "default": 6.0}, "highlightThreshold": {"value": 98.0, "default": 98.0} },
        { "op": "quantize", "tolerance": {"value": 3.5, "default": 3.5} },
        { "op": "refine", "algorithm": "k-means", "iterations": {"value": 1, "default": 1} },
        { "op": "snap", "threshold": {"value": 8.0, "default": 8.0} },
        { "op": "prune", "threshold": {"value": 8.0, "default": 8.0} },
        { "op": "peak_finder", "maxPeaks": 1 },
        { "op": "map", "dither": "none" },
        { "op": "density_floor", "floor": {"value": 0.005, "default": 0.005} }
    ]
}
